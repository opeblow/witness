{
  "name": "@witness/tools",
  "version": "0.1.0",
  "private": true,
  "description": "Operator scripts: deploy the registry, create keys, and verify the live deployment.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "keys": "tsx src/keys.ts",
    "deploy:registry": "tsx src/deploy-registry.ts",
    "verify:live": "tsx src/verify-live.ts",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@witness/core": "0.1.0",
    "@witness/sdk": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
