# Notary service (services/notary). Copy to .env and fill in, or use `npm run keys -w @witness/tools`.

# Secret URI of the sponsor account that pays capture fees. Never commit a real value.
NOTARY_SEED=

NOTARY_PORT=8787
NOTARY_HOST=0.0.0.0
SUBSTRATE_RPC=wss://test-node-v3.portaldot.dev
EVM_RPC=https://test-evm-rpc-v3.portaldot.dev

# Optional: overrides deployments/portaldot-v3-testnet.json
# REGISTRY_ADDRESS=0x...

# Comma-separated list of origins allowed to call the notary, or * for any.
ALLOWED_ORIGINS=*
MAX_CAPTURE_WINDOW_BLOCKS=30
RATE_LIMIT_PER_MINUTE=12
SIGNER_LIMIT_PER_HOUR=120

# Web app (apps/web), read at build time.
# VITE_NOTARY_URL=https://notary.example.com
# VITE_REPOSITORY_URL=https://github.com/<owner>/witness
# WITNESS_BASE_PATH=/witness/
